        "async function get(req) {",
        "  const key = hash(req);",
        "  const hit = store.get(key);",
        "  if (hit) return hit;",
        "  const res = await compute(req);",
        "  store.set(key, res, ttl);",
        "  return res;",
        "}",
        "",
        "function hash(req) {",
        "  return sha(req.url + req.body);",
        "}",
        "",
        "// 14 lines, 66 chars max per line"
